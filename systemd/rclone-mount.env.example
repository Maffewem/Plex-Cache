# /etc/plex-precache/rclone-mount.env — settings for plex-cache-mount.service
# rclone remote and path to mount (from `rclone config`).
REMOTE=myremote:media
# Where Plex libraries point.
MOUNTPOINT=/mnt/remote
RCLONE_CONFIG=/home/USER/.config/rclone/rclone.conf

# Local disk cache. Put it on the fastest disk with the most free space (SSD/NVMe ideal).
CACHE_DIR=/var/cache/plex-cache
# Total cache size. Bigger = more of the library stays local. install.sh sets this
# to about 60% of the free space on CACHE_DIR's disk (minus CACHE_MIN_FREE).
CACHE_MAX_SIZE=20G
# Evict files not accessed for this long.
CACHE_MAX_AGE=72h
# Always keep at least this much disk free for the OS, Plex metadata and transcodes.
CACHE_MIN_FREE=10G
# How far ahead of the reader rclone downloads into the cache, per open file.
READ_AHEAD=1G
# In-RAM buffer per open file (this is the "RAM buffer"). With ~8 GB RAM,
# 128M across a few streams is comfortable; raise it if you have RAM to spare.
BUFFER_SIZE=128M

# Anything else, e.g. "--vfs-read-chunk-streams 4" on rclone >= 1.68 for parallel
# downloads of one file, or "--bwlimit 80M" to leave headroom on the link.
EXTRA_ARGS=
